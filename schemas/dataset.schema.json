{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plantgenewiki.org/schemas/dataset.schema.json",
  "title": "PlantGeneWiki Dataset Record",
  "type": "object",
  "required": ["object_id", "object_type", "id", "name", "dataset_type", "source", "status", "location_policy"],
  "properties": {
    "object_id": { "type": "string" },
    "object_type": { "const": "Dataset" },
    "id": { "type": "string" },
    "name": { "type": "string" },
    "dataset_type": { "type": "string" },
    "source": { "type": "string" },
    "batch_id": { "type": "string" },
    "species": { "type": "array", "items": { "type": "string" }, "default": [] },
    "version": { "type": "string" },
    "location_policy": {
      "type": "string",
      "enum": ["internal_raw_storage", "public_object_storage", "public_repository", "external_source_only"]
    },
    "location": { "type": "object" },
    "checksum": { "type": "string" },
    "parser": { "type": "string" },
    "parser_version": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["registered", "parsed", "normalized", "published", "partial", "failed", "deprecated", "archived"]
    },
    "description": { "type": "string" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  },
  "additionalProperties": true
}
