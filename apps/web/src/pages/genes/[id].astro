---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { datasets, genes, hrefForObjectRef, sequenceRecords, species } from "../../lib/api-data";

export function getStaticPaths() {
  return genes.map((item) => ({ params: { id: item.id }, props: { item } }));
}

const { item } = Astro.props;
const linkedDatasets = (item.datasets ?? [])
  .map((datasetRef) => datasets.find((dataset) => dataset.object_id === datasetRef || dataset.id === datasetRef || `dataset:${dataset.id}` === datasetRef))
  .filter((dataset): dataset is (typeof datasets)[number] => Boolean(dataset));
const linkedSequenceRecords = sequenceRecords.filter((sequenceRecord) => {
  const explicitLink = (item.related_objects ?? []).some((relation) => relation.target === sequenceRecord.object_id);
  const possibleGeneIds = new Set([item.id, item.id.replace(/\.v\d+\.\d+$/, ""), ...(item.aliases ?? [])]);
  return explicitLink || possibleGeneIds.has(sequenceRecord.inferred_gene_id ?? "") || possibleGeneIds.has(sequenceRecord.sequence_id);
});
const shortGeneId = item.id.replace(/\.v\d+\.\d+$/, "");
const speciesRecord = species.find((entry) => entry.id === item.species || entry.object_id === `species:${item.species}` || entry.object_id === item.species);
const evidenceCount = item.evidence_records?.length ?? 0;
const relationCount = item.related_objects?.length ?? 0;
const annotationCount = item.annotations?.length ?? 0;
const datasetCount = linkedDatasets.length || (item.datasets?.length ?? 0);
const sequenceCount = linkedSequenceRecords.length;
const sequenceTotalLength = linkedSequenceRecords.reduce((total, record) => total + (record.length ?? 0), 0);
const sequenceTypes = Array.from(new Set(linkedSequenceRecords.map((record) => record.sequence_type))).filter(Boolean);
const primaryDataset = linkedDatasets[0];
const permanentFields = [
  { label: "Symbol", value: item.name || shortGeneId },
  { label: "Object ID", value: item.object_id },
  { label: "Object Type", value: item.object_type },
  { label: "Species", value: speciesRecord?.name ?? item.species, href: `/species/${item.species}` },
  { label: "Aliases", value: (item.aliases ?? []).join(", ") || "No aliases data available" },
  { label: "Description", value: item.description || "No description data available" },
  { label: "Primary Dataset", value: primaryDataset?.name ?? "No primary dataset linked", href: primaryDataset ? `/datasets/${primaryDataset.id}` : undefined },
  { label: "Sequence Records", value: `${sequenceCount} linked record${sequenceCount === 1 ? "" : "s"}` },
  { label: "Evidence Records", value: `${evidenceCount} evidence record${evidenceCount === 1 ? "" : "s"}` },
  { label: "Relations", value: `${relationCount} relation${relationCount === 1 ? "" : "s"}` }
];
const researchTiles = [
  { label: "DATASETS", value: datasetCount },
  { label: "SEQUENCES", value: sequenceCount },
  { label: "ANNOTATIONS", value: annotationCount },
  { label: "EVIDENCE", value: evidenceCount },
  { label: "RELATIONS", value: relationCount }
];
const hasSummary = Boolean(item.description);
const searchHref = `/search?q=${encodeURIComponent(shortGeneId)}`;
const geneSummaryText = item.description || `No curated summary is available for ${shortGeneId}.`;
const aliasSummary = (item.aliases ?? []).length > 0 ? (item.aliases ?? []).join(", ") : "No aliases data available";
const datasetSummary = linkedDatasets.length > 0
  ? linkedDatasets.map((dataset) => ({ label: dataset.name, href: `/datasets/${dataset.id}` }))
  : [];
const sequenceSummary = linkedSequenceRecords.length > 0
  ? linkedSequenceRecords.map((record) => ({ label: `${record.sequence_type}: ${record.sequence_id}`, href: `/sequence-records/${record.id}` }))
  : [];
const functionSummary = annotationCount > 0
  ? `${annotationCount} normalized annotation record${annotationCount === 1 ? "" : "s"} available`
  : "Functional annotation import pending";
const relationSummary = relationCount > 0
  ? `${relationCount} linked relation${relationCount === 1 ? "" : "s"} available`
  : "No normalized relations available";
---
<BaseLayout title={`${item.name} gene | PlantGeneWiki`} description={item.description}>
  <div class="gene-card-shell">
    <aside class="card-sidebar" aria-label="Gene card navigation">
      <div class="sidebar-group">
        <div class="sidebar-title">Gene Overview</div>
        <a class="sidebar-link" href="#overview">Overview</a>
        <a class="sidebar-link active" href="#aliases">Aliases &amp; Identifiers</a>
        <a class="sidebar-link" href="#summaries">Summaries</a>
        <a class="sidebar-link" href="#research-products">Research Products</a>
      </div>
      <div class="sidebar-group">
        <div class="sidebar-title">Molecular Annotation</div>
        <a class="sidebar-link" href="#genomics">Genomics &amp; Location</a>
        <a class="sidebar-link" href="#sequences">Sequences</a>
        <a class="sidebar-link" href="#datasets">Datasets</a>
        <a class="sidebar-link" href="#relations">Relations</a>
      </div>
      <div class="sidebar-group">
        <div class="sidebar-title">Evidence &amp; Resources</div>
        <a class="sidebar-link" href="#evidence">Evidence Records</a>
      </div>
      <form class="sidebar-search" data-card-search>
        <input name="q" type="search" placeholder="Search in this card" autocomplete="off" />
        <button type="submit" aria-label="Search in this card"><span class="search-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m15.5 15.5 5 5"></path></svg></span></button>
      </form>
    </aside>

    <article class="gene-card-main">
      <header class="gene-hero" id="overview">
        <div>
          <h1 class="gene-title">{shortGeneId} gene</h1>
          <p class="gene-subtitle">{speciesRecord?.name ?? item.species} · {item.object_type} · PlantGeneWiki normalized record</p>
        </div>
        <aside class="status-card">
          <strong>{sequenceTypes[0] ? `${sequenceTypes[0]} Gene Record` : "Plant Gene Record"}</strong>
          Knowledge Score: sample
        </aside>
      </header>

      <section class="gene-overview-summary" aria-label={`Overview summary for ${shortGeneId}`}>
        <div class="overview-row overview-primary">
          <div class="overview-label">PlantGeneWiki Summary</div>
          <div class="overview-content">
            <p><em>{item.name || shortGeneId}</em> is a normalized plant gene object in PlantGeneWiki. This overview summarizes stable identifiers, currently linked datasets, sequence records, evidence, and relationship coverage for quick inspection.</p>
            <p>{geneSummaryText}</p>
          </div>
        </div>

        <div class="overview-row">
          <div class="overview-label">Also known as</div>
          <div class="overview-content">{aliasSummary}</div>
        </div>

        <div class="overview-row">
          <div class="overview-label">Functional Categories</div>
          <div class="overview-content overview-links">
            <span>{functionSummary}</span>
            <a href="#research-products">Research product summary</a>
          </div>
        </div>

        <div class="overview-row">
          <div class="overview-label">Datasets</div>
          <div class="overview-content overview-links">
            {datasetSummary.length > 0 ? datasetSummary.map((dataset, index) => (
              <>
                {index > 0 && <span class="overview-separator">|</span>}
                <a href={dataset.href}>{dataset.label}</a>
              </>
            )) : <span class="overview-muted">No dataset links available</span>}
          </div>
        </div>

        <div class="overview-row">
          <div class="overview-label">Sequence Records</div>
          <div class="overview-content overview-links">
            {sequenceSummary.length > 0 ? sequenceSummary.map((record, index) => (
              <>
                {index > 0 && <span class="overview-separator">|</span>}
                <a href={record.href}>{record.label}</a>
              </>
            )) : <span class="overview-muted">No sequence records linked</span>}
          </div>
        </div>

        <div class="overview-row">
          <div class="overview-label">Relations</div>
          <div class="overview-content overview-links">
            <a href="#relations">{relationSummary}</a>
            <a href="#genomics">Genomics &amp; location</a>
          </div>
        </div>

        <div class="overview-row">
          <div class="overview-label">Evidence</div>
          <div class="overview-content overview-links">
            <a href="#evidence">{evidenceCount} evidence record{evidenceCount === 1 ? "" : "s"}</a>
            <span class="overview-muted">Literature-derived claims will appear after literature normalization.</span>
          </div>
        </div>
      </section>

      <section class="card-section" id="aliases">
        <h2 class="card-section-title">Aliases &amp; Identifiers for {shortGeneId}</h2>
        <div class="jump-row">Jump to: <a href="#aliases-descriptions">Aliases &amp; Descriptions</a><span>|</span><a href="#aliases-other-links">Other Links</a></div>
        <div class="card-section-body">
          <div class="subsection-heading" id="aliases-descriptions">Aliases &amp; Descriptions for {shortGeneId}</div>
          <table class="permanent-field-table">
            <tbody>
              {permanentFields.map((field) => (
                <tr>
                  <th>{field.label}</th>
                  <td>{field.href ? <a href={field.href}>{field.value}</a> : field.value}</td>
                </tr>
              ))}
            </tbody>
          </table>

          <div class="subsection-heading" id="aliases-other-links">Other Links for {shortGeneId}</div>
          <div class="other-links-grid">
            <strong>PlantGeneWiki</strong>
            <a href={searchHref}>Search for {shortGeneId} in PlantGeneWiki</a>
            <strong>Species Page</strong>
            <a href={`/species/${item.species}`}>Open {speciesRecord?.name ?? item.species}</a>
            <strong>Dataset Records</strong>
            <span>
              {linkedDatasets.length > 0 ? linkedDatasets.map((dataset, index) => (
                <>
                  {index > 0 && ", "}
                  <a href={`/datasets/${dataset.id}`}>{dataset.name}</a>
                </>
              )) : "No dataset links available"}
            </span>
            <strong>Sequence Records</strong>
            <span>
              {linkedSequenceRecords.length > 0 ? linkedSequenceRecords.map((record, index) => (
                <>
                  {index > 0 && ", "}
                  <a href={`/sequence-records/${record.id}`}>{record.sequence_id}</a>
                </>
              )) : "No sequence record links available"}
            </span>
          </div>
        </div>
      </section>

      <section class="card-section" id="summaries">
        <h2 class="card-section-title">Summaries for {shortGeneId}</h2>
        <div class="card-section-body">
          {hasSummary ? (
            <div class="summary-grid compact-summary">
              <div class="summary-label">PlantGeneWiki Summary</div>
              <div class="summary-body">
                <p><strong>{item.name}</strong> is a normalized gene object used to validate PlantGeneWiki static publishing, relation linking, dataset provenance, and future dynamic API boundaries.</p>
                <p>{item.description}</p>
              </div>
            </div>
          ) : (
            <p class="empty-state">No Summaries data available for {shortGeneId}</p>
          )}
        </div>
      </section>

      <section class="card-section" id="research-products">
        <h2 class="card-section-title">Research Products for {shortGeneId}</h2>
        <div class="card-section-body">
          <div class="resource-strip" aria-label="Gene resources">
            <div class="resource-icon" aria-hidden="true">DNA</div>
            {researchTiles.map((tile) => (
              <div class="resource-tile">
                <strong>{tile.label}</strong>
                <span>{tile.value}</span>
              </div>
            ))}
          </div>
          <p class="empty-state small">Research product counts currently summarize normalized PlantGeneWiki objects. External product catalogs are not yet imported.</p>
        </div>
      </section>

      <section class="card-section" id="genomics">
        <h2 class="card-section-title">Genomics &amp; Location for {shortGeneId}</h2>
        <div class="jump-row">Jump to: <a href="#genomic-summary">Genomic Locations</a><span>|</span><a href="#sequence-browser">Sequence Records</a><span>|</span><a href="#datasets">Data Sources</a></div>
        <div class="card-section-body">
          <p class="section-intro">
            This section shows normalized sequence resources currently linked to {shortGeneId}. Chromosomal coordinates will be populated when GFF/GTF annotation normalization is added; sequence records already provide dataset provenance, sequence type, length, and stable links.
          </p>
          <div class="sequence-browser" id="sequence-browser">
            <div class="browser-toolbar">
              <strong>PlantGeneWiki</strong>
              <span>{speciesRecord?.name ?? item.species}</span>
              <span>{sequenceTypes.join(", ") || "sequence records"}</span>
              <span>{sequenceTotalLength.toLocaleString()} bp indexed</span>
            </div>
            <div class="browser-ruler" aria-hidden="true">
              <span></span><span></span><span></span><span></span><span></span>
            </div>
            <div class="browser-track-list">
              {linkedSequenceRecords.length > 0 ? linkedSequenceRecords.map((record, index) => (
                <a class="browser-track" href={`/sequence-records/${record.id}`} style={`--track-width: ${Math.max(26, Math.min(96, Math.round((record.length / Math.max(sequenceTotalLength || record.length, record.length)) * 100)))}%; --track-offset: ${Math.min(58, index * 14)}%;`}>
                  <span class="track-label">{record.sequence_type}</span>
                  <span class="track-bar"></span>
                  <span class="track-name">{record.sequence_id}</span>
                  <span class="track-length">{record.length.toLocaleString()} bp</span>
                </a>
              )) : <p class="meta">No sequence records have been linked to this gene in the published sample.</p>}
            </div>
            <div class="browser-legend">
              <span><i class="legend-selected"></i>Linked sequence record</span>
              <span><i class="legend-source"></i>Dataset-derived feature</span>
              <span class="tips">Click a track to open the sequence record page.</span>
            </div>
          </div>
          <div class="location-summary" id="genomic-summary">
            <div>
              <strong>Current Assembly</strong>
              <span>{primaryDataset?.name ?? "No assembly dataset linked"}</span>
            </div>
            <div>
              <strong>Sequence Types</strong>
              <span>{sequenceTypes.join(", ") || "Not available"}</span>
            </div>
            <div>
              <strong>Unified Location</strong>
              <span>Pending GFF/GTF normalization</span>
            </div>
          </div>
        </div>
      </section>

      <section class="card-section" id="datasets">
        <h2 class="card-section-title">Datasets for {shortGeneId}</h2>
        <div class="card-section-body">
          <table class="data-table">
            <tbody>
              <tr><th>Object ID</th><td>{item.object_id}</td></tr>
              <tr>
                <th>Datasets</th>
                <td>
                  {linkedDatasets.length > 0 ? linkedDatasets.map((dataset, index) => (
                    <>
                      {index > 0 && ", "}
                      <a href={`/datasets/${dataset.id}`}>{dataset.name}</a>
                    </>
                  )) : "No datasets linked"}
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="card-section" id="sequences">
        <h2 class="card-section-title">Sequence Records for {shortGeneId}</h2>
        <div class="card-section-body">
          {linkedSequenceRecords.length > 0 ? linkedSequenceRecords.map((sequenceRecord) => (
            <div class="sequence-row">
              <strong><a href={`/sequence-records/${sequenceRecord.id}`}>{sequenceRecord.name}</a></strong>
              <span>{sequenceRecord.sequence_type}</span>
              <span class="meta">Length: {sequenceRecord.length}</span>
            </div>
          )) : <p class="empty-state">No sequence records have been linked to this gene in the published sample.</p>}
        </div>
      </section>

      <section class="card-section" id="evidence">
        <h2 class="card-section-title">Evidence Records for {shortGeneId}</h2>
        <div class="card-section-body object-list">
          {(item.evidence_records ?? []).length > 0 ? (item.evidence_records ?? []).map((record) => (
            <article class="object-card">
              <strong>{record.claim}</strong>
              <span class="meta">{record.source} - confidence: {record.confidence}</span>
            </article>
          )) : <p class="empty-state">No evidence records available for {shortGeneId}</p>}
        </div>
      </section>

      <section class="card-section" id="relations">
        <h2 class="card-section-title">Relations for {shortGeneId}</h2>
        <div class="card-section-body object-list">
          {(item.related_objects ?? []).length > 0 ? (item.related_objects ?? []).map((relation) => {
            const href = hrefForObjectRef(relation.target);
            return (
              <article class="object-card">
                <strong>{relation.predicate}</strong>
                <span>{href ? <a href={href}>{relation.label ?? relation.target}</a> : relation.label ?? relation.target}</span>
                <span class="meta">{relation.target}</span>
              </article>
            );
          }) : <p class="empty-state">No relations available for {shortGeneId}</p>}
        </div>
      </section>
    </article>
  </div>

  <script>
    const sidebarLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".card-sidebar .sidebar-link[href^='#']"));
    const sectionById = new Map<string, HTMLAnchorElement>();
    sidebarLinks.forEach((link) => {
      const hash = link.getAttribute("href") ?? "";
      const id = hash.slice(1);
      if (id) {
        sectionById.set(id, link);
      }
    });
    const trackedSections = Array.from(sectionById.keys())
      .map((id) => document.getElementById(id))
      .filter((section): section is HTMLElement => section instanceof HTMLElement);

    function setActiveSidebarLink(id: string) {
      const nextActiveLink = sectionById.get(id);
      if (!nextActiveLink) return;
      sidebarLinks.forEach((link) => {
        const isActive = link === nextActiveLink;
        link.classList.toggle("active", isActive);
        if (isActive) {
          link.setAttribute("aria-current", "true");
        } else {
          link.removeAttribute("aria-current");
        }
      });
    }

    function updateActiveSidebarLink() {
      const headerOffset = 120;
      const currentSection = trackedSections.reduce((current, section) => {
        const top = section.getBoundingClientRect().top - headerOffset;
        return top <= 0 ? section : current;
      }, trackedSections[0]);
      if (currentSection?.id) {
        setActiveSidebarLink(currentSection.id);
      }
    }

    sidebarLinks.forEach((link) => {
      link.addEventListener("click", () => {
        const hash = link.getAttribute("href") ?? "";
        setActiveSidebarLink(hash.slice(1));
      });
    });

    updateActiveSidebarLink();
    window.addEventListener("scroll", updateActiveSidebarLink, { passive: true });
    window.addEventListener("hashchange", updateActiveSidebarLink);

    const cardSearchForm = document.querySelector<HTMLFormElement>(".sidebar-search[data-card-search]");
    const cardSearchInput = cardSearchForm?.querySelector<HTMLInputElement>("input[name='q']");
    const cardSearchRoot = document.querySelector<HTMLElement>(".gene-card-main");

    function escapeRegExp(value: string) {
      return value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    }

    function clearCardSearchHighlights() {
      cardSearchRoot?.querySelectorAll("mark.card-search-hit").forEach((mark) => {
        const parent = mark.parentNode;
        if (!parent) return;
        parent.replaceChild(document.createTextNode(mark.textContent ?? ""), mark);
        parent.normalize();
      });
    }

    function highlightCardSearch(query: string) {
      clearCardSearchHighlights();
      const trimmedQuery = query.trim();
      if (!trimmedQuery || !cardSearchRoot) return [];

      const matcher = new RegExp(escapeRegExp(trimmedQuery), "gi");
      const walker = document.createTreeWalker(cardSearchRoot, NodeFilter.SHOW_TEXT, {
        acceptNode(node) {
          const parent = node.parentElement;
          if (!parent || !node.textContent?.trim()) return NodeFilter.FILTER_REJECT;
          if (["SCRIPT", "STYLE", "MARK"].includes(parent.tagName)) return NodeFilter.FILTER_REJECT;
          matcher.lastIndex = 0;
          return matcher.test(node.textContent) ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
        }
      });
      const textNodes: Text[] = [];
      while (walker.nextNode()) {
        textNodes.push(walker.currentNode as Text);
      }

      const hits: HTMLElement[] = [];
      textNodes.forEach((node) => {
        const text = node.textContent ?? "";
        const fragment = document.createDocumentFragment();
        let lastIndex = 0;
        text.replace(matcher, (match, offset) => {
          if (offset > lastIndex) {
            fragment.append(document.createTextNode(text.slice(lastIndex, offset)));
          }
          const mark = document.createElement("mark");
          mark.className = "card-search-hit";
          mark.textContent = match;
          fragment.append(mark);
          hits.push(mark);
          lastIndex = offset + match.length;
          return match;
        });
        if (lastIndex < text.length) {
          fragment.append(document.createTextNode(text.slice(lastIndex)));
        }
        node.parentNode?.replaceChild(fragment, node);
      });
      return hits;
    }

    cardSearchInput?.addEventListener("input", () => {
      highlightCardSearch(cardSearchInput.value);
    });

    cardSearchForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      const hits = highlightCardSearch(cardSearchInput?.value ?? "");
      hits[0]?.scrollIntoView({ behavior: "smooth", block: "center" });
    });

  </script>

</BaseLayout>
