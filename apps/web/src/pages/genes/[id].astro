---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { datasets, genes, hrefForObjectRef, sequenceRecords, species } from "../../lib/api-data";

export function getStaticPaths() {
  return genes.map((item) => ({ params: { id: item.id }, props: { item } }));
}

const { item } = Astro.props;
const linkedDatasets = (item.datasets ?? [])
  .map((datasetRef) => datasets.find((dataset) => dataset.object_id === datasetRef || dataset.id === datasetRef || `dataset:${dataset.id}` === datasetRef))
  .filter((dataset): dataset is (typeof datasets)[number] => Boolean(dataset));
const linkedSequenceRecords = sequenceRecords.filter((sequenceRecord) => {
  const explicitLink = (item.related_objects ?? []).some((relation) => relation.target === sequenceRecord.object_id);
  const possibleGeneIds = new Set([item.id, item.id.replace(/\.v\d+\.\d+$/, ""), ...(item.aliases ?? [])]);
  return explicitLink || possibleGeneIds.has(sequenceRecord.inferred_gene_id ?? "") || possibleGeneIds.has(sequenceRecord.sequence_id);
});
const shortGeneId = item.id.replace(/\.v\d+\.\d+$/, "");
const speciesRecord = species.find((entry) => entry.id === item.species || entry.object_id === `species:${item.species}` || entry.object_id === item.species);
const evidenceCount = item.evidence_records?.length ?? 0;
const relationCount = item.related_objects?.length ?? 0;
const annotationCount = item.annotations?.length ?? 0;
const datasetCount = linkedDatasets.length || (item.datasets?.length ?? 0);
const sequenceCount = linkedSequenceRecords.length;
const sequenceTotalLength = linkedSequenceRecords.reduce((total, record) => total + (record.length ?? 0), 0);
const sequenceTypes = Array.from(new Set(linkedSequenceRecords.map((record) => record.sequence_type))).filter(Boolean);
const primaryDataset = linkedDatasets[0];
const resourceTiles = [
  { label: "DATASETS", value: datasetCount },
  { label: "SEQUENCES", value: sequenceCount },
  { label: "ANNOTATIONS", value: annotationCount },
  { label: "EVIDENCE", value: evidenceCount },
  { label: "RELATIONS", value: relationCount }
];
---
<BaseLayout title={`${item.name} gene | PlantGeneWiki`} description={item.description}>
  <div class="gene-card-shell">
    <aside class="card-sidebar" aria-label="Gene card navigation">
      <div class="sidebar-group">
        <div class="sidebar-title">Gene Overview</div>
        <a class="sidebar-link active" href="#overview">Overview <span>({evidenceCount + relationCount})</span></a>
        <a class="sidebar-link" href="#aliases">Aliases &amp; Identifiers</a>
        <a class="sidebar-link" href="#summaries">Summaries</a>
      </div>
      <div class="sidebar-group">
        <div class="sidebar-title">Molecular Annotation</div>
        <a class="sidebar-link" href="#genomics">Genomics &amp; Location</a>
        <a class="sidebar-link" href="#sequences">Sequences <span>({sequenceCount})</span></a>
        <a class="sidebar-link" href="#datasets">Datasets <span>({datasetCount})</span></a>
        <a class="sidebar-link" href="#relations">Relations <span>({relationCount})</span></a>
      </div>
      <div class="sidebar-group">
        <div class="sidebar-title">Evidence &amp; Resources</div>
        <a class="sidebar-link" href="#evidence">Evidence Records <span>({evidenceCount})</span></a>
        <a class="sidebar-link" href="/search">Search</a>
      </div>
      <form class="sidebar-search" action="/search">
        <input name="q" type="search" placeholder="Search in this Card" value={shortGeneId} />
        <button type="submit" aria-label="Search in this card">?</button>
      </form>
    </aside>

    <article class="gene-card-main">
      <header class="gene-hero" id="overview">
        <div>
          <h1 class="gene-title">{shortGeneId} gene <span>- {item.name}</span></h1>
          <p class="gene-subtitle">{speciesRecord?.name ?? item.species} normalized gene card</p>
        </div>
        <aside class="status-card">
          <strong>Plant Gene Record</strong>
          Knowledge Score: sample
        </aside>
      </header>

      <section class="summary-grid" id="summaries">
        <div class="summary-label">PlantGeneWiki Summary</div>
        <div class="summary-body">
          <p><strong>{item.name}</strong> is a normalized sample gene object used to validate PlantGeneWiki static publishing, relation linking, dataset provenance, and future dynamic API boundaries.</p>
          <p>{item.description}</p>
          <p class="summary-links">
            Gene families and functional categories are represented here as structured annotations, linked sequence records, datasets, evidence claims, and knowledge-graph relations.
          </p>
        </div>
      </section>

      <section class="fact-list" id="aliases">
        <div class="fact-label">Gene object</div>
        <div>{item.object_id}</div>
        <div class="fact-label">Species</div>
        <div><a href={`/species/${item.species}`}>{speciesRecord?.name ?? item.species}</a></div>
        <div class="fact-label">Also known as</div>
        <div>{(item.aliases ?? []).join(", ") || "No aliases in published sample"}</div>
        <div class="fact-label">Functional categories</div>
        <div class="annotation-list">
          {(item.annotations ?? []).length > 0 ? (item.annotations ?? []).map((annotation) => <span class="pill">{annotation}</span>) : <span class="meta">No functional annotation in published sample</span>}
        </div>
      </section>

      <section class="card-section" id="genomics">
        <h2 class="card-section-title">Genomics &amp; Sequence Records for {shortGeneId}</h2>
        <div class="jump-row">Jump to: <a href="#genomic-summary">Genomic Summary</a><span>|</span><a href="#sequence-browser">Sequence Records</a><span>|</span><a href="#datasets">Data Sources</a></div>
        <div class="card-section-body">
          <div class="resource-strip" aria-label="Gene resources">
            <div class="resource-icon" aria-hidden="true">DNA</div>
            {resourceTiles.map((tile) => (
              <div class="resource-tile">
                <strong>{tile.label}</strong>
                <span>{tile.value}</span>
              </div>
            ))}
          </div>
          <p class="section-intro">
            This section shows the normalized sequence resources currently linked to {shortGeneId}. Full genomic coordinates will be populated when GFF/GTF annotation normalization is added; sequence records already provide dataset provenance, sequence type, length, and stable links.
          </p>
          <div class="sequence-browser" id="sequence-browser">
            <div class="browser-toolbar">
              <strong>PlantGeneWiki</strong>
              <span>{speciesRecord?.name ?? item.species}</span>
              <span>{sequenceTypes.join(", ") || "sequence records"}</span>
              <span>{sequenceTotalLength.toLocaleString()} bp indexed</span>
            </div>
            <div class="browser-ruler" aria-hidden="true">
              <span></span><span></span><span></span><span></span><span></span>
            </div>
            <div class="browser-track-list">
              {linkedSequenceRecords.length > 0 ? linkedSequenceRecords.map((record, index) => (
                <a class="browser-track" href={`/sequence-records/${record.id}`} style={`--track-width: ${Math.max(26, Math.min(96, Math.round((record.length / Math.max(sequenceTotalLength || record.length, record.length)) * 100)))}%; --track-offset: ${Math.min(58, index * 14)}%;`}>
                  <span class="track-label">{record.sequence_type}</span>
                  <span class="track-bar"></span>
                  <span class="track-name">{record.sequence_id}</span>
                  <span class="track-length">{record.length.toLocaleString()} bp</span>
                </a>
              )) : <p class="meta">No sequence records have been linked to this gene in the published sample.</p>}
            </div>
            <div class="browser-legend">
              <span><i class="legend-selected"></i>Linked sequence record</span>
              <span><i class="legend-source"></i>Dataset-derived feature</span>
              <span class="tips">Click a track to open the sequence record page.</span>
            </div>
          </div>
          <div class="location-summary" id="genomic-summary">
            <div>
              <strong>Current Assembly</strong>
              <span>{primaryDataset?.name ?? "No assembly dataset linked"}</span>
            </div>
            <div>
              <strong>Sequence Types</strong>
              <span>{sequenceTypes.join(", ") || "Not available"}</span>
            </div>
            <div>
              <strong>Unified Location</strong>
              <span>Pending GFF/GTF normalization</span>
            </div>
          </div>
        </div>
      </section>

      <section class="card-section" id="datasets">
        <h2 class="card-section-title">Datasets for {shortGeneId}</h2>
        <div class="card-section-body">
          <table class="data-table">
            <tbody>
              <tr><th>Object ID</th><td>{item.object_id}</td></tr>
              <tr>
                <th>Datasets</th>
                <td>
                  {linkedDatasets.length > 0 ? linkedDatasets.map((dataset, index) => (
                    <>
                      {index > 0 && ", "}
                      <a href={`/datasets/${dataset.id}`}>{dataset.name}</a>
                    </>
                  )) : (item.datasets ?? []).join(", ")}
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="card-section" id="sequences">
        <h2 class="card-section-title">Sequence Records for {shortGeneId}</h2>
        <div class="card-section-body">
          {linkedSequenceRecords.length > 0 ? linkedSequenceRecords.map((sequenceRecord) => (
            <div class="sequence-row">
              <strong><a href={`/sequence-records/${sequenceRecord.id}`}>{sequenceRecord.name}</a></strong>
              <span>{sequenceRecord.sequence_type}</span>
              <span class="meta">Length: {sequenceRecord.length}</span>
            </div>
          )) : <p class="meta">No sequence records have been linked to this gene in the published sample.</p>}
        </div>
      </section>

      <section class="card-section" id="evidence">
        <h2 class="card-section-title">Evidence Records for {shortGeneId}</h2>
        <div class="card-section-body object-list">
          {(item.evidence_records ?? []).map((record) => (
            <article class="object-card">
              <strong>{record.claim}</strong>
              <span class="meta">{record.source} - confidence: {record.confidence}</span>
            </article>
          ))}
        </div>
      </section>

      <section class="card-section" id="relations">
        <h2 class="card-section-title">Relations for {shortGeneId}</h2>
        <div class="card-section-body object-list">
          {(item.related_objects ?? []).map((relation) => {
            const href = hrefForObjectRef(relation.target);
            return (
              <article class="object-card">
                <strong>{relation.predicate}</strong>
                <span>{href ? <a href={href}>{relation.label ?? relation.target}</a> : relation.label ?? relation.target}</span>
                <span class="meta">{relation.target}</span>
              </article>
            );
          })}
        </div>
      </section>
    </article>
  </div>
</BaseLayout>
