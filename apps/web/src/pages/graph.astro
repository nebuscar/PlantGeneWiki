---
import BaseLayout from "../layouts/BaseLayout.astro";

const apiBase = import.meta.env.PUBLIC_API_BASE ?? "";
---
<BaseLayout title="Knowledge Graph | PlantGeneWiki" description="API-backed PlantGeneWiki knowledge graph browser.">
  <section class="kg-page" data-api-base={apiBase}>
    <header class="kg-hero">
      <div>
        <h1 class="page-title">Knowledge Graph</h1>
        <p class="lede">
          Explore a graph-centered view of PlantGeneWiki objects. The graph is loaded from the backend SQLite graph index,
          not from static sample cards.
        </p>
      </div>
      <div class="kg-status-card">
        <strong>Graph API</strong>
        <span data-api-status>Checking...</span>
      </div>
    </header>

    <form class="kg-query-panel" id="kg-query-form">
      <label>
        <span class="meta">Gene query</span>
        <input id="kg-query" name="q" type="search" value="Atha01G0000010" list="kg-gene-options" autocomplete="off" />
        <datalist id="kg-gene-options"></datalist>
      </label>
      <label>
        <span class="meta">Species</span>
        <input id="kg-species" name="species_id" type="search" value="arabidopsis_thaliana" list="kg-species-options" autocomplete="off" />
        <datalist id="kg-species-options">
          <option value="arabidopsis_thaliana">Arabidopsis thaliana</option>
          <option value="abies_alba">Abies alba</option>
          <option value="zea_mays">Zea mays</option>
          <option value="oryza_sativa">Oryza sativa</option>
          <option value="glycine_max">Glycine max</option>
          <option value="brassica_napus">Brassica napus</option>
          <option value="brassica_rapa">Brassica rapa</option>
          <option value="solanum_lycopersicum">Solanum lycopersicum</option>
          <option value="vitis_vinifera">Vitis vinifera</option>
          <option value="zoysia_japonica">Zoysia japonica</option>
        </datalist>
      </label>
      <button class="primary-button" type="submit">Load Graph</button>
    </form>

    <section class="kg-workspace">
      <div class="kg-canvas-card">
        <div class="kg-canvas-header">
          <div>
            <strong data-graph-title>Gene-centered graph</strong>
            <span data-graph-subtitle>Loading default node...</span>
          </div>
          <div class="kg-legend">
            <span><i class="kg-dot gene"></i>Gene</span>
            <span><i class="kg-dot species"></i>Species</span>
            <span><i class="kg-dot dataset"></i>Dataset</span>
            <span><i class="kg-dot sequence"></i>Sequence</span>
            <span><i class="kg-dot annotation"></i>Location/Structure</span>
          </div>
        </div>
        <svg class="kg-svg" viewBox="0 0 980 620" role="img" aria-label="PlantGeneWiki knowledge graph" data-graph-svg></svg>
      </div>

      <aside class="kg-detail-card" data-node-detail>
        <span class="pill">Node Detail</span>
        <h2>Select a node</h2>
        <p class="meta">Click a graph node to inspect its identifier, type, species, and available properties.</p>
      </aside>
    </section>
  </section>

  <script is:inline define:vars={{ apiBase }}>
    const resolvedApiBase = apiBase || '';
    const form = document.querySelector("#kg-query-form");
    const queryInput = document.querySelector("#kg-query");
    const geneOptions = document.querySelector("#kg-gene-options");
    const speciesInput = document.querySelector("#kg-species");
    const svg = document.querySelector("[data-graph-svg]");
    const detail = document.querySelector("[data-node-detail]");
    const apiStatus = document.querySelector("[data-api-status]");
    const graphTitle = document.querySelector("[data-graph-title]");
    const graphSubtitle = document.querySelector("[data-graph-subtitle]");

    const escapeHtml = (value) => String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;");

    const shortId = (value) => {
      const text = String(value ?? "");
      if (text.length <= 46) return text;
      return `${text.slice(0, 24)}...${text.slice(-16)}`;
    };

    const typeClass = (type) => {
      if (type === "Gene") return "gene";
      if (type === "Species") return "species";
      if (type === "Dataset") return "dataset";
      if (type === "SequenceRecord") return "sequence";
      if (type === "GeneLocation" || type === "GeneStructure") return "annotation";
      return "other";
    };

    const typeRadius = (type) => {
      if (type === "Gene") return 46;
      if (type === "Species") return 34;
      if (type === "Dataset") return 32;
      if (type === "SequenceRecord") return 28;
      return 26;
    };

    let suggestionTimer;
    let suggestionAbort;

    const setGeneOptions = (nodes) => {
      geneOptions.innerHTML = (nodes ?? []).map((node) => {
        const value = node.properties?.id || node.label || node.node_id;
        const label = `${node.label || value} · ${node.species_id || ""}`;
        return `<option value="${escapeHtml(value)}">${escapeHtml(label)}</option>`;
      }).join("");
    };

    const loadGeneSuggestions = () => {
      const q = queryInput.value.trim();
      const species = speciesInput.value.trim();
      if (q.length < 2 || !species) {
        setGeneOptions([]);
        return;
      }
      window.clearTimeout(suggestionTimer);
      suggestionTimer = window.setTimeout(async () => {
        try {
          suggestionAbort?.abort();
          suggestionAbort = new AbortController();
          const params = new URLSearchParams({
            q,
            object_type: "Gene",
            species_id: species,
            limit: "12"
          });
          const response = await fetch(`${resolvedApiBase}/api/graph/search?${params.toString()}`, {
            signal: suggestionAbort.signal
          });
          if (!response.ok) return;
          const payload = await response.json();
          setGeneOptions(payload.nodes ?? []);
        } catch (error) {
          if (error.name !== "AbortError") setGeneOptions([]);
        }
      }, 220);
    };

    const renderDetail = (node) => {
      const props = node.properties ?? {};
      const location = props.genome_location
        ? `${props.genome_location.seqid}:${props.genome_location.start}-${props.genome_location.end} (${props.genome_location.strand ?? "?"})`
        : "Not available";
      detail.innerHTML = `
        <span class="pill">${escapeHtml(node.object_type)}</span>
        <h2>${escapeHtml(node.label || node.node_id)}</h2>
        <dl class="kg-detail-list">
          <dt>Node ID</dt><dd><code>${escapeHtml(node.node_id)}</code></dd>
          <dt>Species</dt><dd>${escapeHtml(node.species_id || "Not available")}</dd>
          <dt>Description</dt><dd>${escapeHtml(props.description || "Not available")}</dd>
          <dt>Location</dt><dd>${escapeHtml(location)}</dd>
        </dl>
        ${node.object_type === "Gene" ? `<a class="primary-link" href="/gene?node=${encodeURIComponent(node.node_id)}">Open gene detail page</a>` : ""}
      `;
    };

    const renderGraph = (payload) => {
      const center = payload.node;
      const relatedNodes = payload.nodes ?? [];
      const edges = payload.edges ?? [];
      const allNodes = [center, ...relatedNodes].filter(Boolean);
      const nodeById = new Map(allNodes.map((node) => [node.node_id, node]));

      const width = 980;
      const height = 620;
      const cx = width / 2;
      const cy = height / 2;
      const ring = Math.min(width, height) * 0.34;
      const positioned = new Map();
      positioned.set(center.node_id, { ...center, x: cx, y: cy });

      relatedNodes.forEach((node, index) => {
        const angle = (-90 + index * (360 / Math.max(relatedNodes.length, 1))) * Math.PI / 180;
        const radius = ring + (index % 2) * 38;
        positioned.set(node.node_id, {
          ...node,
          x: cx + Math.cos(angle) * radius,
          y: cy + Math.sin(angle) * radius
        });
      });

      const visibleEdges = edges
        .map((edge) => ({ ...edge, sourceNode: positioned.get(edge.source), targetNode: positioned.get(edge.target) }))
        .filter((edge) => edge.sourceNode && edge.targetNode);

      graphTitle.textContent = center.label || center.node_id;
      graphSubtitle.textContent = `${allNodes.length} nodes · ${visibleEdges.length} visible edges`;

      svg.innerHTML = `
        <defs>
          <marker id="kg-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M 0 0 L 10 5 L 0 10 z"></path>
          </marker>
        </defs>
        <g class="kg-edge-layer">
          ${visibleEdges.map((edge) => {
            const mx = (edge.sourceNode.x + edge.targetNode.x) / 2;
            const my = (edge.sourceNode.y + edge.targetNode.y) / 2;
            return `
              <g class="kg-edge-group">
                <line class="kg-edge-line" x1="${edge.sourceNode.x}" y1="${edge.sourceNode.y}" x2="${edge.targetNode.x}" y2="${edge.targetNode.y}" marker-end="url(#kg-arrow)"></line>
                <text class="kg-edge-text" x="${mx}" y="${my}">${escapeHtml(edge.predicate)}</text>
              </g>
            `;
          }).join("")}
        </g>
        <g class="kg-node-layer">
          ${Array.from(positioned.values()).map((node) => `
            <g class="kg-node ${typeClass(node.object_type)}" data-node-id="${escapeHtml(node.node_id)}" transform="translate(${node.x}, ${node.y})">
              <circle r="${typeRadius(node.object_type)}"></circle>
              <text class="kg-node-label" y="-4">${escapeHtml(shortId(node.label || node.node_id))}</text>
              <text class="kg-node-type" y="15">${escapeHtml(node.object_type)}</text>
            </g>
          `).join("")}
        </g>
      `;

      svg.querySelectorAll("[data-node-id]").forEach((element) => {
        element.addEventListener("click", () => {
          const node = nodeById.get(element.dataset.nodeId);
          if (node) renderDetail(node);
        });
      });
      renderDetail(center);
    };

    const loadGraph = async () => {
      const q = queryInput.value.trim();
      const species = speciesInput.value.trim();
      if (!q || !species) return;
      apiStatus.textContent = "Querying graph API...";
      svg.innerHTML = `<text x="50%" y="50%" text-anchor="middle" class="kg-loading">Loading graph...</text>`;
      try {
        const searchParams = new URLSearchParams({ q, object_type: "Gene", species_id: species, limit: "1" });
        const searchResponse = await fetch(`${resolvedApiBase}/api/graph/search?${searchParams.toString()}`);
        if (!searchResponse.ok) throw new Error(`Search HTTP ${searchResponse.status}`);
        const searchPayload = await searchResponse.json();
        const node = searchPayload.nodes?.[0];
        if (!node) throw new Error("No matching gene node");

        const neighborsResponse = await fetch(`${resolvedApiBase}/api/graph/neighbors/${encodeURIComponent(node.node_id)}?limit=40`);
        if (!neighborsResponse.ok) throw new Error(`Neighbors HTTP ${neighborsResponse.status}`);
        const payload = await neighborsResponse.json();
        apiStatus.textContent = "Connected";
        renderGraph(payload);
      } catch (error) {
        apiStatus.textContent = "Error";
        svg.innerHTML = `<text x="50%" y="50%" text-anchor="middle" class="kg-loading">Graph request failed: ${escapeHtml(error.message)}</text>`;
        detail.innerHTML = `<span class="pill">Error</span><h2>Unable to load graph</h2><p class="meta">${escapeHtml(error.message)}</p>`;
      }
    };

    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      loadGraph();
    });

    queryInput?.addEventListener("input", loadGeneSuggestions);
    queryInput?.addEventListener("focus", loadGeneSuggestions);
    speciesInput?.addEventListener("input", () => {
      setGeneOptions([]);
      loadGeneSuggestions();
    });

    loadGraph();
    loadGeneSuggestions();
  </script>
</BaseLayout>
