---
import BaseLayout from "../layouts/BaseLayout.astro";

const apiBase = import.meta.env.PUBLIC_API_BASE ?? "";
---
<BaseLayout title="Gene | PlantGeneWiki" description="API-backed PlantGeneWiki gene card.">
  <section class="api-gene-page" data-api-base={apiBase}>
    <div class="api-gene-toolbar">
      <a href="/search">Back to graph search</a>
      <code data-api-url>Resolving graph API endpoint...</code>
    </div>

    <article class="api-gene-card" id="gene-card" aria-live="polite">
      <span class="pill">Loading</span>
      <h1 class="page-title">Loading gene card...</h1>
      <p class="lede">Fetching node and neighbor records from the graph API.</p>
    </article>
  </section>

  <script is:inline define:vars={{ apiBase }}>
    const resolvedApiBase = apiBase || '';
    const card = document.querySelector("#gene-card");
    const params = new URLSearchParams(window.location.search);
    const nodeId = params.get("node");

    document.querySelector("[data-api-url]").textContent = `${resolvedApiBase}/api/graph/neighbors/{node_id}`;

    const escapeHtml = (value) => String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;");

    const asList = (items) => {
      if (!Array.isArray(items) || !items.length) return `<span class="muted-text">Not available</span>`;
      return `<ul>${items.map((item) => `<li>${escapeHtml(item)}</li>`).join("")}</ul>`;
    };

    const formatLocation = (location) => {
      if (!location) return "Not available";
      const strand = location.strand ? ` (${location.strand})` : "";
      return `${location.seqid}:${location.start}-${location.end}${strand}`;
    };

    const relatedNodeById = (payload) => new Map((payload.nodes ?? []).map((node) => [node.node_id, node]));

    const renderGeneCard = (payload) => {
      const node = payload.node;
      const props = node.properties ?? {};
      const related = relatedNodeById(payload);
      const outgoing = (payload.edges ?? []).filter((edge) => edge.source === node.node_id);
      const relationRows = outgoing.map((edge) => {
        const target = related.get(edge.target);
        const label = target?.label || edge.properties?.label || edge.target;
        return `
          <tr>
            <td><code>${escapeHtml(edge.predicate)}</code></td>
            <td>${escapeHtml(target?.object_type || "Object")}</td>
            <td><code>${escapeHtml(label)}</code></td>
          </tr>
        `;
      }).join("");

      const goTerms = props.annotations?.go ?? [];
      const tf = props.annotations?.transcription_factor;
      const sequenceRecords = props.sequence_records ?? [];

      card.innerHTML = `
        <header class="api-gene-hero">
          <div>
            <span class="pill">${escapeHtml(node.object_type)}</span>
            <h1 class="page-title">${escapeHtml(props.name || node.label || node.node_id)}</h1>
            <p class="lede">${escapeHtml(props.description || "No description available.")}</p>
          </div>
          <div class="api-gene-status">
            <strong>Graph-backed record</strong>
            <span>${escapeHtml(node.species_id || "unknown species")}</span>
          </div>
        </header>

        <section class="api-gene-grid">
          <div class="api-gene-panel">
            <h2>Identifiers</h2>
            <dl>
              <dt>Node ID</dt><dd><code>${escapeHtml(node.node_id)}</code></dd>
              <dt>Gene ID</dt><dd>${escapeHtml(props.id || node.label)}</dd>
              <dt>Species</dt><dd>${escapeHtml(props.species || node.species_id)}</dd>
              <dt>Aliases</dt><dd>${asList(props.aliases)}</dd>
            </dl>
          </div>

          <div class="api-gene-panel">
            <h2>Genome Location</h2>
            <dl>
              <dt>Location</dt><dd>${escapeHtml(formatLocation(props.genome_location))}</dd>
              <dt>Assembly</dt><dd>${escapeHtml(props.genome_location?.assembly || "Not available")}</dd>
              <dt>Coordinate System</dt><dd>${escapeHtml(props.genome_location?.coordinate_system || "Not available")}</dd>
            </dl>
          </div>

          <div class="api-gene-panel">
            <h2>Functional Annotation</h2>
            <dl>
              <dt>GO Terms</dt><dd>${asList(goTerms)}</dd>
              <dt>Transcription Factor</dt><dd>${tf ? `${escapeHtml(tf.type)} / ${escapeHtml(tf.family)}` : "Not available"}</dd>
            </dl>
          </div>

          <div class="api-gene-panel">
            <h2>Sequence Records</h2>
            ${asList(sequenceRecords)}
          </div>
        </section>

        <section class="api-gene-panel api-gene-relations">
          <h2>Graph Relations</h2>
          <table class="permanent-field-table">
            <thead><tr><th>Predicate</th><th>Target Type</th><th>Target</th></tr></thead>
            <tbody>${relationRows || `<tr><td colspan="3">No outgoing relations returned.</td></tr>`}</tbody>
          </table>
        </section>
      `;
    };

    const loadGene = async () => {
      if (!nodeId) {
        card.innerHTML = `<span class="pill">Missing node</span><h1 class="page-title">No graph node selected</h1><p class="lede">Open this page from graph search results, or pass <code>?node=gene:...</code>.</p>`;
        return;
      }
      try {
        const response = await fetch(`${resolvedApiBase}/api/graph/neighbors/${encodeURIComponent(nodeId)}?limit=50`);
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const payload = await response.json();
        renderGeneCard(payload);
      } catch (error) {
        card.innerHTML = `<span class="pill">Error</span><h1 class="page-title">Gene API request failed</h1><p class="lede">${escapeHtml(error.message)}</p>`;
      }
    };

    loadGene();
  </script>
</BaseLayout>

