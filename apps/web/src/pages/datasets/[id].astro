---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { datasets } from "../../lib/api-data";

export function getStaticPaths() {
  return datasets.map((item) => ({ params: { id: item.id }, props: { item } }));
}

const { item } = Astro.props;
---
<BaseLayout title={`${item.name} | PlantGeneWiki`} description={item.description}>
  <h1 class="page-title">{item.name}</h1>
  <p class="lede">{item.description}</p>
  <section class="panel section">
    <h2>Dataset Record</h2>
    <table class="data-table">
      <tbody>
        <tr><th>Object ID</th><td>{item.object_id}</td></tr>
        <tr><th>Dataset type</th><td>{item.dataset_type}</td></tr>
        <tr><th>Source</th><td>{item.source}</td></tr>
        <tr><th>Status</th><td>{item.status}</td></tr>
        <tr><th>Location policy</th><td>{item.location_policy}</td></tr>
        <tr><th>Updated</th><td>{item.updated_at}</td></tr>
      </tbody>
    </table>
  </section>
</BaseLayout>
