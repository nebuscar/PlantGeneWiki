---
import BaseLayout from "../layouts/BaseLayout.astro";
import { datasets, genes, searchItems, sequenceRecords, species } from "../lib/api-data";
---
<BaseLayout title="PlantGeneWiki" description="A GeneCards-inspired plant genomics knowledge base prototype." showHeaderSearch={false}>
  <section class="hero">
    <h1><strong>PlantGeneWiki:</strong> The Plant Gene Knowledge Base</h1>
    <p class="lede">
      PlantGeneWiki is a searchable, integrative wiki-style knowledge base for plant genes, species, datasets, sequence records, evidence, and future knowledge graph reasoning.
    </p>
  </section>

  <section class="explore-panel" aria-label="Explore PlantGeneWiki">
    <div class="explore-inner">
      <div class="explore-row">
        <h2 class="explore-title">Explore a Gene</h2>
        <form class="search-line" data-gene-jump>
          <input name="gene" type="search" placeholder="Enter name of gene" required autocomplete="off" />
          <button class="search-action" type="submit" aria-label="Open gene" disabled aria-disabled="true">&gt;</button>
        </form>
        <p class="meta">Examples: <a href="/genes/Atha01G0000010.v1.36">Atha01G0000010.v1.36</a>, <a href="/sequence-records/Atha01G0000010.1.v1.36">Atha01G0000010.1.v1.36</a></p>
      </div>
      <div class="explore-row">
        <h2 class="explore-title">Search PlantGeneWiki for any term</h2>
        <form class="search-line" action="/search" data-requires-input>
          <input name="q" type="search" placeholder="Enter search term(s)" required autocomplete="off" />
          <button class="search-action" type="submit" aria-label="Search" disabled aria-disabled="true"><span class="search-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m15.5 15.5 5 5"></path></svg></span></button>
        </form>
        <p class="meta">Examples: Arabidopsis, PGCP, CDS, Abies alba</p>
      </div>
    </div>
    <div class="index-strip">
      <strong>Knowledge object index:</strong>
      Species {species.length}, Genes {genes.length}, Datasets {datasets.length}, Sequence records {sequenceRecords.length}, Search rows {searchItems.length}
    </div>
  </section>

  <section class="card-grid" aria-label="Primary routes">
    <article class="card">
      <h2>Species</h2>
      <p class="meta">Browse organism-level context, genome versions, datasets, and related genes.</p>
      <a href="/species/arabidopsis_thaliana">Open species page</a>
    </article>
    <article class="card">
      <h2>Gene</h2>
      <p class="meta">Inspect normalized gene metadata, relations, evidence, datasets, and linked sequence records.</p>
      <a href="/genes/Atha01G0000010.v1.36">Open gene card</a>
    </article>
    <article class="card">
      <h2>Dataset</h2>
      <p class="meta">Track source, version, status, parser, and raw data publication policy.</p>
      <a href="/datasets/pgcp_atha_gene_json_202606">Open dataset page</a>
    </article>
  </section>
  <script is:inline>
    const updateHomeSearchButtons = () => {
      document.querySelectorAll(".search-line[data-requires-input], .search-line[data-gene-jump]").forEach((form) => {
        const input = form.querySelector("input");
        const button = form.querySelector("button");
        if (!input || !button) return;
        const hasValue = input.value.trim().length > 0;
        button.disabled = !hasValue;
        button.setAttribute("aria-disabled", String(!hasValue));
      });
    };

    document.querySelectorAll(".search-line[data-requires-input] input, .search-line[data-gene-jump] input").forEach((input) => {
      input.addEventListener("input", updateHomeSearchButtons);
    });

    document.querySelector(".search-line[data-gene-jump]")?.addEventListener("submit", (event) => {
      event.preventDefault();
      const input = event.currentTarget.querySelector("input");
      const geneId = input?.value.trim();
      if (!geneId) return;
      window.location.href = `/genes/${encodeURIComponent(geneId)}`;
    });

    updateHomeSearchButtons();
  </script>
</BaseLayout>
