---
import BaseLayout from "../layouts/BaseLayout.astro";

const apiBase = import.meta.env.PUBLIC_API_BASE ?? "";
---
<BaseLayout title="PlantGeneWiki" description="A graph-backed plant genomics knowledge base prototype." showHeaderSearch={false}>
  <section class="hero">
    <h1><strong>PlantGeneWiki:</strong> The Plant Gene Knowledge Base</h1>
    <p class="lede">
      PlantGeneWiki is a searchable, graph-backed knowledge base for plant genes, species, datasets,
      sequence records, evidence, and future knowledge graph reasoning.
    </p>
  </section>

  <section class="explore-panel" aria-label="Explore PlantGeneWiki" data-api-base={apiBase}>
    <div class="explore-inner">
      <div class="explore-row">
        <h2 class="explore-title">Explore a Gene</h2>
        <form class="search-line" data-gene-search>
          <input name="gene" type="search" placeholder="Enter gene ID, e.g. Atha01G0000010" autocomplete="off" />
          <button class="search-action" type="submit" aria-label="Search gene">&gt;</button>
        </form>
        <p class="meta">
          Examples:
          <button class="example-link" type="button" data-fill-target="gene" data-fill-value="Atha01G0000010">Atha01G0000010</button>,
          <button class="example-link" type="button" data-fill-target="gene" data-fill-value="Atha01G0000010.v1.36">Atha01G0000010.v1.36</button>
        </p>
      </div>
      <div class="explore-row">
        <h2 class="explore-title">Search PlantGeneWiki for any term</h2>
        <form class="search-line" action="/search" data-requires-input>
          <input name="q" type="search" placeholder="Enter search term(s)" autocomplete="off" />
          <button class="search-action" type="submit" aria-label="Search"><span class="search-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m15.5 15.5 5 5"></path></svg></span></button>
        </form>
        <p class="meta">
          Examples:
          <button class="example-link" type="button" data-fill-target="q" data-fill-value="Atha01G0000010">Atha01G0000010</button>,
          <button class="example-link" type="button" data-fill-target="q" data-fill-value="arabidopsis_thaliana">arabidopsis_thaliana</button>,
          <button class="example-link" type="button" data-fill-target="q" data-fill-value="zea_mays">zea_mays</button>
        </p>
      </div>
    </div>
    <div class="index-strip" id="graph-summary">
      <strong>Knowledge graph index:</strong>
      <span data-summary-status>Loading graph summary from API...</span>
    </div>
  </section>

  <section class="card-grid" aria-label="Primary routes">
    <article class="card">
      <h2>Species</h2>
      <p class="meta">Browse organism-level context, genome versions, datasets, and related genes.</p>
      <a href="/species/arabidopsis_thaliana">Open species page</a>
    </article>
    <article class="card">
      <h2>Graph Search</h2>
      <p class="meta">Query the backend graph index instead of static sample JSON files.</p>
      <a href="/search?q=Atha01G0000010">Search graph API</a>
    </article>
    <article class="card">
      <h2>Graph API</h2>
      <p class="meta">Inspect live node, edge, species, and neighbor endpoints.</p>
      <a href="/search?q=Atha01G0000010&object_type=Gene&species_id=arabidopsis_thaliana">Open API-backed search</a>
    </article>
  </section>
  <script is:inline define:vars={{ apiBase }}>
    const getInputValue = (form) => form.querySelector("input")?.value.trim() ?? "";

    const resolvedApiBase = apiBase || `${window.location.protocol}//${window.location.hostname}:8001`;
    const formatNumber = (value) => new Intl.NumberFormat("en-US").format(value ?? 0);

    const summaryTarget = document.querySelector("[data-summary-status]");
    fetch(`${resolvedApiBase}/api/graph/summary`)
      .then((response) => response.ok ? response.json() : Promise.reject(new Error(`HTTP ${response.status}`)))
      .then((summary) => {
        summaryTarget.textContent = `Species ${formatNumber(summary.species_dirs)}, Nodes ${formatNumber(summary.node_count)}, Edges ${formatNumber(summary.edge_count)}, Genes ${formatNumber(summary.node_types?.Gene)}`;
      })
      .catch((error) => {
        summaryTarget.textContent = `Graph API unavailable: ${error.message}`;
      });

    document.querySelector(".search-line[data-gene-search]")?.addEventListener("submit", (event) => {
      event.preventDefault();
      const geneId = getInputValue(event.currentTarget);
      if (!geneId) return;
      const params = new URLSearchParams({
        q: geneId,
        object_type: "Gene",
        species_id: "arabidopsis_thaliana"
      });
      window.location.href = `/search?${params.toString()}`;
    });

    document.querySelector(".search-line[data-requires-input]")?.addEventListener("submit", (event) => {
      if (getInputValue(event.currentTarget)) return;
      event.preventDefault();
    });

    document.querySelectorAll(".example-link[data-fill-target]").forEach((button) => {
      button.addEventListener("click", () => {
        const target = button.dataset.fillTarget;
        const value = button.dataset.fillValue ?? "";
        const input = document.querySelector(`.search-line input[name="${target}"]`);
        if (!input) return;
        input.value = value;
        input.focus();
      });
    });
  </script>
</BaseLayout>
