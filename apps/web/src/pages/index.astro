---
import BaseLayout from "../layouts/BaseLayout.astro";
import { datasets, genes, searchItems, sequenceRecords, species } from "../lib/api-data";
---
<BaseLayout title="PlantGeneWiki" description="A GeneCards-inspired plant genomics knowledge base prototype." showHeaderSearch={false}>
  <section class="hero">
    <h1><strong>PlantGeneWiki:</strong> The Plant Gene Knowledge Base</h1>
    <p class="lede">
      PlantGeneWiki is a searchable, integrative wiki-style knowledge base for plant genes, species, datasets, sequence records, evidence, and future knowledge graph reasoning.
    </p>
  </section>

  <section class="explore-panel" aria-label="Explore PlantGeneWiki">
    <div class="explore-inner">
      <div class="explore-row">
        <h2 class="explore-title">Explore a Gene</h2>
        <form class="search-line" data-gene-jump>
          <input name="gene" type="search" placeholder="Enter name of gene" autocomplete="off" />
          <button class="search-action" type="submit" aria-label="Open gene">&gt;</button>
        </form>
        <p class="meta">Examples: <button class="example-link" type="button" data-fill-target="gene" data-fill-value="Atha01G0000010.v1.36">Atha01G0000010.v1.36</button>, <button class="example-link" type="button" data-fill-target="gene" data-fill-value="Atha01G0000010.1.v1.36">Atha01G0000010.1.v1.36</button></p>
      </div>
      <div class="explore-row">
        <h2 class="explore-title">Search PlantGeneWiki for any term</h2>
        <form class="search-line" action="/search" data-requires-input>
          <input name="q" type="search" placeholder="Enter search term(s)" autocomplete="off" />
          <button class="search-action" type="submit" aria-label="Search"><span class="search-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m15.5 15.5 5 5"></path></svg></span></button>
        </form>
        <p class="meta">Examples: <button class="example-link" type="button" data-fill-target="q" data-fill-value="Arabidopsis">Arabidopsis</button>, <button class="example-link" type="button" data-fill-target="q" data-fill-value="PGCP">PGCP</button>, <button class="example-link" type="button" data-fill-target="q" data-fill-value="CDS">CDS</button>, <button class="example-link" type="button" data-fill-target="q" data-fill-value="Abies alba">Abies alba</button></p>
      </div>
    </div>
    <div class="index-strip">
      <strong>Knowledge object index:</strong>
      Species {species.length}, Genes {genes.length}, Datasets {datasets.length}, Sequence records {sequenceRecords.length}, Search rows {searchItems.length}
    </div>
  </section>

  <section class="card-grid" aria-label="Primary routes">
    <article class="card">
      <h2>Species</h2>
      <p class="meta">Browse organism-level context, genome versions, datasets, and related genes.</p>
      <a href="/species/arabidopsis_thaliana">Open species page</a>
    </article>
    <article class="card">
      <h2>Gene</h2>
      <p class="meta">Inspect normalized gene metadata, relations, evidence, datasets, and linked sequence records.</p>
      <a href="/genes/Atha01G0000010.v1.36">Open gene card</a>
    </article>
    <article class="card">
      <h2>Dataset</h2>
      <p class="meta">Track source, version, status, parser, and raw data publication policy.</p>
      <a href="/datasets/pgcp_atha_gene_json_202606">Open dataset page</a>
    </article>
  </section>
  <script is:inline>
    const getInputValue = (form) => form.querySelector("input")?.value.trim() ?? "";

    document.querySelector(".search-line[data-gene-jump]")?.addEventListener("submit", (event) => {
      event.preventDefault();
      const geneId = getInputValue(event.currentTarget);
      if (!geneId) return;
      window.location.href = `/genes/${encodeURIComponent(geneId)}`;
    });

    document.querySelector(".search-line[data-requires-input]")?.addEventListener("submit", (event) => {
      if (getInputValue(event.currentTarget)) return;
      event.preventDefault();
    });

    document.querySelectorAll(".example-link[data-fill-target]").forEach((button) => {
      button.addEventListener("click", () => {
        const target = button.dataset.fillTarget;
        const value = button.dataset.fillValue ?? "";
        const input = document.querySelector(`.search-line input[name="${target}"]`);
        if (!input) return;
        input.value = value;
        input.focus();
      });
    });
  </script>
</BaseLayout>
