---
import BaseLayout from "../layouts/BaseLayout.astro";
import { datasets, genes, searchItems, sequenceRecords, species } from "../lib/api-data";
---
<BaseLayout title="PlantGeneWiki" description="A GeneCards-inspired plant genomics knowledge base prototype.">
  <section class="hero">
    <h1><strong>PlantGeneWiki:</strong> The Plant Gene Knowledge Base</h1>
    <p class="lede">
      PlantGeneWiki is a searchable, integrative wiki-style knowledge base for plant genes, species, datasets, sequence records, evidence, and future knowledge graph reasoning.
    </p>
  </section>

  <section class="explore-panel" aria-label="Explore PlantGeneWiki">
    <div class="explore-inner">
      <div class="explore-row">
        <h2 class="explore-title">Explore a Gene</h2>
        <form class="search-line" action="/genes/Atha01G0000010.v1.36">
          <input type="search" placeholder="Enter name of gene" value="Atha01G0000010.v1.36" />
          <button class="search-action" type="submit" aria-label="Open sample gene">&gt;</button>
        </form>
        <p class="meta">Examples: <a href="/genes/Atha01G0000010.v1.36">Atha01G0000010.v1.36</a>, <a href="/sequence-records/Atha01G0000010.1.v1.36">Atha01G0000010.1.v1.36</a></p>
      </div>
      <div class="explore-row">
        <h2 class="explore-title">Search PlantGeneWiki for any term</h2>
        <form class="search-line" action="/search">
          <input name="q" type="search" placeholder="Enter search term(s)" />
          <button class="search-action" type="submit" aria-label="Search"><span class="search-icon" aria-hidden="true">&#128269;</span></button>
        </form>
        <p class="meta">Examples: Arabidopsis, PGCP, CDS, Abies alba</p>
      </div>
    </div>
    <div class="index-strip">
      <strong>Knowledge object index:</strong>
      Species {species.length}, Genes {genes.length}, Datasets {datasets.length}, Sequence records {sequenceRecords.length}, Search rows {searchItems.length}
    </div>
  </section>

  <section class="card-grid" aria-label="Primary routes">
    <article class="card">
      <h2>Species</h2>
      <p class="meta">Browse organism-level context, genome versions, datasets, and related genes.</p>
      <a href="/species/arabidopsis_thaliana">Open species page</a>
    </article>
    <article class="card">
      <h2>Gene</h2>
      <p class="meta">Inspect normalized gene metadata, relations, evidence, datasets, and linked sequence records.</p>
      <a href="/genes/Atha01G0000010.v1.36">Open gene card</a>
    </article>
    <article class="card">
      <h2>Dataset</h2>
      <p class="meta">Track source, version, status, parser, and raw data publication policy.</p>
      <a href="/datasets/pgcp_atha_gene_json_202606">Open dataset page</a>
    </article>
  </section>
</BaseLayout>