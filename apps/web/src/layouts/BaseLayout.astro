---
import "../styles/global.css";

const { title = "PlantGeneWiki", description = "Static-first PlantGeneWiki knowledge base.", showHeaderSearch = true } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="PlantGeneWiki home">
        <img class="brand-logo" src="/assets/plantgenewiki-logo-full.png" alt="PlantGeneWiki" />
      </a>
      <nav aria-label="Main navigation">
        <a href="/">Home</a>
        <a href="/search">Search</a>
        <a href="/graph">Graph</a>
        <a href="/species/arabidopsis_thaliana">Species</a>
        <a href="/genes/Atha01G0000010.v1.36">Gene</a>
      </nav>
      {showHeaderSearch && (
        <form class="header-search" action="/search" role="search">
          <input name="q" type="search" placeholder="Search PlantGeneWiki" />
          <button type="submit" aria-label="Search"><span class="search-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m15.5 15.5 5 5"></path></svg></span></button>
        </form>
      )}
    </header>
    <main class="page-shell">
      <slot />
    </main>
  </body>
</html>