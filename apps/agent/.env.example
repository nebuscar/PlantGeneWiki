ANTHROPIC_API_KEY=your-anthropic-api-key
# Chainlit 认证密钥（随机字符串即可）
CHAINLIT_AUTH_SECRET=change-me-to-random-string

# 数据路径（留空则使用 config.py 中的默认值）
PLANTSDB_SPECIES_DIR=/path/to/result/result_imp/species
PLANTSDB_HOMOLOG_DIR=/path/to/result/result_imp/homolog
PLANTSDB_EXPRESSION_DIR=/path/to/downloads/IMP
